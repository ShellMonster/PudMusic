{
  "name": "布丁音乐",
  "slug": "pudmusic",
  "identifier": "io.github.shellmonster.biu",
  "version": "1.0.4",
  "out": "build",
  "urlSchemes": ["pudmusic"],
  "fileAssociations": [
    {
      "ext": ["mp3", "flac", "wav", "ogg", "aiff", "aif", "aifc"],
      "name": "音频文件",
      "role": "Viewer"
    }
  ],
  "copyright": "Copyright © 2026 ShellMonster. Based on Biu, Copyright © 2022–2025 wood3n. PolyForm Noncommercial 1.0.0 — see the licenses folder shipped with this app.",
  "macos": {
    "dmgTitle": "安装布丁音乐",
    "infoPlist": {
      "LSApplicationCategoryType": "public.app-category.music",
      "CFBundleDevelopmentRegion": "zh-Hans",
      "CFBundleLocalizations": ["zh-Hans"],
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "音频文件",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Default",
          "CFBundleTypeExtensions": ["mp3", "flac", "wav", "m4a", "aac", "ogg", "aiff", "aif", "aifc"]
        }
      ]
    }
  },
  "windows": {
    "installerInclude": "resources/windows/fileassoc.nsh"
  },
  "linux": {
    "webview": false,
    "comment": "B 站音乐播放器",
    "categories": ["Audio", "Music"],
    "depends": ["libayatana-appindicator3-1"]
  },
  "updates": {
    "publicKey": "oJyYKaPIGn5RA8yPM/I395n6D+wn/PdaZv58jqBDrO0=",
    "github": "ShellMonster/PudMusic",
    "changelog": "RELEASE-NOTES.md"
  }
}
